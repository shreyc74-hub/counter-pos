# Leave empty to run on in-browser demo data.
# Supabase → Project settings → API keys: the project URL and the anon / publishable key.
# Either naming works (next.config.ts maps them): SUPABASE_URL + SUPABASE_ANON_KEY,
# or NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY (or ..._PUBLISHABLE_KEY).
# Never put the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
